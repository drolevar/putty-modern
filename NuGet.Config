<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <solution>
    <add key="disableSourceControlIntegration" value="true" />
  </solution>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="docking-prerelease" value="deps/nuget" />
  </packageSources>

  <!-- The docking library comes from deps/nuget until the release that has DocumentHost.Arrange is on nuget.org;
       everything else from nuget.org. See deps/nuget/README.md. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="docking-prerelease">
      <package pattern="Digi21.WinUI.Docking" />
    </packageSource>
  </packageSourceMapping>
</configuration>
