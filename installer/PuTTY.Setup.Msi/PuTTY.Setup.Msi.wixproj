<Project Sdk="WixToolset.Sdk/7.0.1">
  <!-- The package: PuTTY Modern's NativeAOT publish folder, installed per machine under Program Files. -->
  <PropertyGroup>
    <OutputName>PuTTYModern</OutputName>

    <!-- Where the app's publish folder is. By default the package publishes it first (dotnet publish, the same command CI runs);
         CI publishes in a step of its own and passes -p:PublishApp=false so that it is not done twice. -->
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</RepoRoot>
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(RepoRoot)artifacts\publish\PuTTY.App\release_win-x64\</AppPublishDir>
    <PublishApp Condition="'$(PublishApp)' == ''">true</PublishApp>
    <DefineConstants>$(DefineConstants);AppPublishDir=$(AppPublishDir);AppIcon=$(RepoRoot)src\PuTTY.App\Assets\AppIcon.ico</DefineConstants>

    <!-- ICE61 warns that the package may "remove only older versions of itself": MajorUpgrade AllowSameVersionUpgrades makes the
         maximum version of the upgrade inclusive, on purpose, so that a rebuilt package of the same version (every local build is
         0.1.0.0; CI's differ only in the fourth field, which Windows Installer ignores) replaces the one installed. ICE69 warns that the shortcut (in a component of its
         own, see Package.wxs) points at a file of another component: both are in the one feature, which is what ICE69 asks for. -->
    <SuppressIces>ICE61;ICE69</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Common\Common.wxi" Link="Common.wxi" />
  </ItemGroup>

  <!-- The licence page's text (notices.rtf, $(var.NoticesRtf)) is made from LICENSE and THIRD-PARTY-NOTICES.txt at build time. -->
  <Import Project="..\Common\Notices.targets" />

  <Target Name="PublishApp" BeforeTargets="PrepareForBuild" Condition="'$(PublishApp)' == 'true'">
    <!-- dotnet publish does not clear its output folder, and the package packs everything in it: files of an older build (the 292
         of the first one, with the AI and ML components) would be installed too. The folder is rebuilt from nothing. -->
    <RemoveDir Directories="$(RepoRoot)artifacts\publish\PuTTY.App\release_win-x64" />
    <Message Importance="high" Text="Publishing PuTTY.App (NativeAOT, win-x64) for the package ..." />
    <Exec Command="dotnet publish &quot;$(RepoRoot)src\PuTTY.App&quot; -c Release -r win-x64" WorkingDirectory="$(RepoRoot)" />
  </Target>

  <Target Name="CheckAppPublishDir" BeforeTargets="PrepareForBuild" DependsOnTargets="PublishApp">
    <Error Condition="!Exists('$(AppPublishDir)PuTTY.App.exe')"
           Text="No PuTTY.App.exe in $(AppPublishDir). Publish first (dotnet publish src\PuTTY.App -c Release -r win-x64) or pass -p:AppPublishDir=..." />
  </Target>
</Project>
