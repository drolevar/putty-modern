<Project Sdk="WixToolset.Sdk/7.0.1">
  <!-- The setup program: one .exe that installs the Visual C++ runtime the engine needs (when the machine has an older one or
       none) and then the package. -->
  <PropertyGroup>
    <OutputName>PuTTYModernSetup</OutputName>
    <OutputType>Bundle</OutputType>
    <!-- vc_redist.wxi is written into the intermediate folder by the FindVcRedist target. -->
    <IncludeSearchPaths>$(IncludeSearchPaths);$(IntermediateOutputPath)</IncludeSearchPaths>
    <DefineConstants>$(DefineConstants);AppIcon=$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'src', 'PuTTY.App', 'Assets', 'AppIcon.ico'))</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuTTY.Setup.Msi\PuTTY.Setup.Msi.wixproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Common\Common.wxi" Link="Common.wxi" />
    <None Include="scripts\FindVcRedist.ps1" />
    <!-- The theme and its strings are named by the standard bootstrapper application (Bundle.wxs). The strings file must not also
         be taken as a localization file of the project: that would move the output into an en-US folder, as the package's. -->
    <EmbeddedResource Remove="Theme\**" />
    <Content Include="Theme\Theme.xml" />
    <Content Include="Theme\Theme.wxl" />
  </ItemGroup>

  <!-- The licence box's text (notices.rtf, $(var.NoticesRtf)) is made from LICENSE and THIRD-PARTY-NOTICES.txt at build time. -->
  <Import Project="..\Common\Notices.targets" />

  <PropertyGroup>
    <PrepareForBuildDependsOn>$(PrepareForBuildDependsOn);FindVcRedist</PrepareForBuildDependsOn>
  </PropertyGroup>
  <Target Name="FindVcRedist">
    <Exec Command="powershell.exe -NonInteractive -ExecutionPolicy Bypass -NoProfile -File &quot;$(MSBuildThisFileDirectory)scripts\FindVcRedist.ps1&quot; -OutputFilePath &quot;$(IntermediateOutputPath)vc_redist.wxi&quot;" />
  </Target>
</Project>
