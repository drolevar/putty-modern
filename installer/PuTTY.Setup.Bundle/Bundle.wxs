<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <?include Common.wxi ?>

  <!-- The bundle's upgrade code is its own (not the package's): never change it. -->
  <Bundle Name="$(ProgName)"
          Manufacturer="$(Manufacturer)"
          Version="$(SetupVersion)"
          UpgradeCode="A02FAC35-0085-44F1-86FE-F0DE44C379D8"
          HelpUrl="$(HelpUrl)"
          AboutUrl="$(HelpUrl)"
          IconSourceFile="$(AppIcon)">

    <!-- The setup window: WiX's standard bootstrapper application with a theme of our own (Theme\Theme.xml: a banner across the top,
         a welcome text that credits Simon Tatham and PuTTY, the licence text in the window above the "I agree" box). The banner
         is the picture of the MSI's wizard; the licence is the RTF made at build time from LICENSE and THIRD-PARTY-NOTICES.txt
         ($(NoticesRtf), see ..\Common\Notices.targets), the same text as the package's licence page. -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="rtfLicense"
                                              ThemeFile="Theme\Theme.xml"
                                              LocalizationFile="Theme\Theme.wxl"
                                              LogoFile="$(InstallerAssets)banner.bmp"
                                              LicenseFile="$(NoticesRtf)"
                                              SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <Chain>
      <PackageGroupRef Id="VcRedist" />
      <MsiPackage Id="Setup" SourceFile="$(var.PuTTY.Setup.Msi.TargetPath)" Compressed="yes" />
    </Chain>
  </Bundle>
</Wix>
