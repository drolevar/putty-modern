<Project>
  <!-- Settings shared by the installer projects. This file stands alone on purpose: the nearest Directory.Build.props wins, so
       the repository's own one (LangVersion, NetVersion, UseArtifactsOutput) does not apply here, and the installer is not
       part of PuTTY.slnx: building the solution never needs WiX. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <!-- WiX 7's binaries are under the Open Source Maintenance Fee EULA, which a build has to accept:
         https://docs.firegiant.com/wix/osmf/  The owner accepted it for this project on 2026-11-13.
         The fee applies to revenue-generating use above US$10,000 a year, and is paid by sponsoring the wixtoolset
         organisation on GitHub. -->
    <AcceptEula>wix7</AcceptEula>

    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US</Cultures>
    <SuppressValidation>false</SuppressValidation>

    <!-- Everything the installer builds goes under artifacts\installer (git-ignored), one folder per project. -->
    <InstallerArtifacts>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'artifacts', 'installer', '$(MSBuildProjectName)'))</InstallerArtifacts>
    <BaseIntermediateOutputPath>$(InstallerArtifacts)obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
    <BaseOutputPath>$(InstallerArtifacts)bin\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>

    <!-- Common.wxi: the product's name, the manufacturer and the links, in one place for the package and the bundle. -->
    <IncludeSearchPaths>$(MSBuildThisFileDirectory)Common\</IncludeSearchPaths>
    <!-- Assets: the dialogs' pictures, drawn by tools\make-app-art.ps1 together with the app icon. -->
    <DefineConstants>$(DefineConstants);SetupVersion=$(SetupVersion);InstallerAssets=$(MSBuildThisFileDirectory)Assets\</DefineConstants>
  </PropertyGroup>
</Project>
