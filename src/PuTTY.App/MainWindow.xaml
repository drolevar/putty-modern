<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PuTTY.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docking="using:Digi21.WinUI.Docking"
    Title="PuTTY">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="PuTTY">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Same docking structure as the Figma sketch "PuTTY · Docked workspace":
             Sessions on the left, terminal documents in the centre with the
             Connection log below, Session details on the right. Placeholders only. -->
        <!-- The session command bar of the sketch; built in code (CommandBarController). -->
        <UserControl x:Name="CommandBarHost" Grid.Row="1" HorizontalContentAlignment="Stretch" />

        <docking:DockSite x:Name="DockSite" Grid.Row="2" AutoHideStripPlacement="InPlace">
            <docking:SplitContainer Orientation="Horizontal">

                <docking:ToolWindowContainer docking:DockSite.RelativeSize="0.2">
                    <docking:ToolWindow Title="Sessions" SerializationId="sessions">
                        <!-- The list of PuTTY's saved sessions is built in code (SessionListController). -->
                        <UserControl x:Name="SessionsHost"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Stretch" />
                    </docking:ToolWindow>
                </docking:ToolWindowContainer>

                <docking:SplitContainer docking:DockSite.RelativeSize="0.6" Orientation="Vertical">

                    <docking:DocumentHost docking:DockSite.RelativeSize="0.75">
                        <docking:DocumentContainer>
                            <docking:DocumentWindow x:Name="TerminalDocument" Title="Terminal" SerializationId="doc.terminal">
                                <!-- The terminal view is attached to this control in code (TerminalViewController);
                                     until a session is shown it holds the empty state below (or, when the engine
                                     could not start, the reason). -->
                                <UserControl x:Name="TerminalHost"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Stretch">
                                    <Grid>
                                        <StackPanel x:Name="WelcomePanel"
                                                    MaxWidth="420"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="8">
                                            <TextBlock HorizontalAlignment="Center"
                                                       AutomationProperties.AutomationId="WelcomeTitle"
                                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                                       Text="No session open" />
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="Open a saved session from the Sessions panel, or start a new one."
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <Button x:Name="WelcomeNewSession"
                                                    Margin="0,8,0,0"
                                                    HorizontalAlignment="Center"
                                                    AutomationProperties.AutomationId="WelcomeNewSession"
                                                    Click="OnWelcomeNewSession"
                                                    Content="New session"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="EngineProblemText"
                                                   Margin="12"
                                                   AutomationProperties.AutomationId="EngineProblem"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </UserControl>
                            </docking:DocumentWindow>
                        </docking:DocumentContainer>
                    </docking:DocumentHost>

                    <docking:ToolWindowContainer docking:DockSite.RelativeSize="0.25">
                        <docking:ToolWindow x:Name="LogPanel" Title="Connection log" SerializationId="log">
                            <!-- The log of every session's connection is built in code (ConnectionLogController). -->
                            <UserControl x:Name="LogHost"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch" />
                        </docking:ToolWindow>
                    </docking:ToolWindowContainer>

                </docking:SplitContainer>

                <docking:ToolWindowContainer docking:DockSite.RelativeSize="0.2">
                    <docking:ToolWindow x:Name="DetailsPanel" Title="Session details" SerializationId="details">
                        <!-- The open session's name, state and Session settings button are built in code (SessionDetailsController). -->
                        <UserControl x:Name="DetailsHost"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Stretch" />
                    </docking:ToolWindow>
                </docking:ToolWindowContainer>

            </docking:SplitContainer>
        </docking:DockSite>

        <!-- Built in code (StatusBarController). -->
        <UserControl x:Name="StatusBarHost" Grid.Row="3" HorizontalContentAlignment="Stretch" />
    </Grid>
</Window>
