<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PuTTY.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docking="using:Digi21.WinUI.Docking"
    Title="PuTTY">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="PuTTY">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Same docking structure as the Figma sketch "PuTTY · Docked workspace":
             Sessions on the left, terminal documents in the centre with the
             Connection log below, Session details on the right. Placeholders only. -->
        <docking:DockSite x:Name="DockSite" Grid.Row="1">
            <docking:SplitContainer Orientation="Horizontal">

                <docking:ToolWindowContainer docking:DockSite.RelativeSize="0.2">
                    <docking:ToolWindow Title="Sessions" SerializationId="sessions">
                        <TextBlock Margin="12" Text="Saved sessions (placeholder)" />
                    </docking:ToolWindow>
                </docking:ToolWindowContainer>

                <docking:SplitContainer docking:DockSite.RelativeSize="0.6" Orientation="Vertical">

                    <docking:DocumentHost docking:DockSite.RelativeSize="0.75">
                        <docking:DocumentContainer>
                            <docking:DocumentWindow Title="web-prod-01" SerializationId="doc.web-prod-01">
                                <TextBlock Margin="12" Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}" />
                            </docking:DocumentWindow>
                        </docking:DocumentContainer>
                    </docking:DocumentHost>

                    <docking:ToolWindowContainer docking:DockSite.RelativeSize="0.25">
                        <docking:ToolWindow Title="Connection log" SerializationId="log">
                            <TextBlock Margin="12" Text="Connection log (placeholder)" />
                        </docking:ToolWindow>
                    </docking:ToolWindowContainer>

                </docking:SplitContainer>

                <docking:ToolWindowContainer docking:DockSite.RelativeSize="0.2">
                    <docking:ToolWindow Title="Session details" SerializationId="details">
                        <TextBlock Margin="12" Text="Session details (placeholder)" />
                    </docking:ToolWindow>
                </docking:ToolWindowContainer>

            </docking:SplitContainer>
        </docking:DockSite>
    </Grid>
</Window>
