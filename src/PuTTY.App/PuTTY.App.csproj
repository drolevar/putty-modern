<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PuTTY.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Unpackaged, self-contained Windows App SDK (avoids WindowsAppSDK issue 6897,
         single-project MSIX + PublishAot on the .NET 11 SDK). Packaging happens
         separately with winapp package. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- x64 only for now: the ARM64 MSVC tools are not installed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <!-- Workaround for WindowsAppSDK issue 6897: on the .NET 11 SDK, PublishAot turns on
         UseOptimizedPublish, which runs XAML compilation before references are resolved
         and fails with WMC1007. Verified on 11.0.100-rc.3 with Windows App SDK 2.6.5
         even for an unpackaged app. Remove once a fixed SDK or build tools ship. -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
    <!-- Required by CsWinRT for AOT (error CsWinRT1030): Digi21.WinUI.Docking types
         implement generic WinRT interfaces, so CsWinRT must generate unsafe code
         for them in this project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Digi21.WinUI.Docking" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuTTY.Interop\PuTTY.Interop.csproj" />
  </ItemGroup>

  <!-- WORKAROUND (Beads issues putty-modern-8nd and its follow-up; details in CLAUDE.md):
       under NativeAOT the content of docked windows is silently dropped (titles render,
       content does not) unless a docking container type is preserved. Rooting DockSite
       alone fixes it, at about +1.3 MB, versus +4.5 MB for rooting the whole assembly.
       The cause is not yet understood. Verified on .NET 11 RC3 + Windows App SDK 2.6.5. -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <!-- Builds the native engine first and ships puttyengine.dll next to the app (build and
       publish output). -->
  <Import Project="..\..\build\NativeEngine.targets" />

</Project>
