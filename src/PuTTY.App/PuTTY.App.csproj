<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PuTTY.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Unpackaged, self-contained Windows App SDK (avoids WindowsAppSDK issue 6897,
         single-project MSIX + PublishAot on the .NET 11 SDK). Packaging happens
         separately with winapp package. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- x64 only for now: the ARM64 MSVC tools are not installed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <!-- Workaround for WindowsAppSDK issue 6897: on the .NET 11 SDK, PublishAot turns on
         UseOptimizedPublish, which runs XAML compilation before references are resolved
         and fails with WMC1007. Verified on 11.0.100-rc.3 and again on 11.0.100 final (where removing this fails as MSB3030) with Windows App SDK 2.6.5
         even for an unpackaged app. Remove once a fixed SDK or build tools ship. -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
    <!-- Required by CsWinRT for AOT (error CsWinRT1030): Digi21.WinUI.Docking types
         implement generic WinRT interfaces, so CsWinRT must generate unsafe code
         for them in this project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Digi21.WinUI.Docking" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuTTY.Interop\PuTTY.Interop.csproj" />
    <ProjectReference Include="..\PuTTY.Sessions\PuTTY.Sessions.csproj" />
  </ItemGroup>

  <!-- NativeAOT and the docking library (Beads putty-modern-sqm, solved): the library gets some WinUI
       classes only from its control templates and casts to them. AotTypeAnchors.cs keeps those classes
       known to the WinRT projection; it replaces the DockSite trimmer root this project used to carry,
       which fixed one symptom by accident and left others (the Close buttons) broken. -->

  <!-- Builds the native engine first and ships puttyengine.dll next to the app (build and
       publish output). -->
  <Import Project="..\..\build\NativeEngine.targets" />

</Project>
