<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PuTTY.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Unpackaged, self-contained Windows App SDK (avoids WindowsAppSDK issue 6897,
         single-project MSIX + PublishAot on the .NET 11 SDK). Packaging happens
         separately with winapp package. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- x64 only for now: the ARM64 MSVC tools are not installed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <!-- Workaround for WindowsAppSDK issue 6897: on the .NET 11 SDK, PublishAot turns on
         UseOptimizedPublish, which runs XAML compilation before references are resolved
         and fails with WMC1007. Verified on 11.0.100-rc.3 with Windows App SDK 2.6.5
         even for an unpackaged app. Remove once a fixed SDK or build tools ship. -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
    <!-- Required by CsWinRT for AOT (error CsWinRT1030): Digi21.WinUI.Docking types
         implement generic WinRT interfaces, so CsWinRT must generate unsafe code
         for them in this project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Digi21.WinUI.Docking" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PuTTY.Interop\PuTTY.Interop.csproj" />
    <!-- Builds the native engine first (CMake + Ninja). It produces no assembly, so skip
         target-framework negotiation and reference no output. -->
    <ProjectReference Include="..\PuTTY.Native\PuTTY.Native.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- WORKAROUND (tracked in Beads issue putty-modern-8nd): Digi21.WinUI.Docking is not
       marked trim/AOT-safe. Under NativeAOT the content of docked windows is silently
       dropped (titles render, content does not) unless the whole assembly is rooted.
       Verified on .NET 11 RC3 + Windows App SDK 2.6.5. Costs about 4.5 MB in the exe.
       Replace with a targeted fix once the exact trimmed members are known. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Digi21.WinUI.Docking" />
  </ItemGroup>

  <!-- Ship the native engine next to the app (build output and publish output). It is added
       in a target, not as a static item with an Exists() condition: the DLL does not exist
       yet at evaluation time on a clean tree. The PuTTY.Native reference guarantees it has
       been built by the time this runs. -->
  <Target Name="StageNativeEngine" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Include="$(ArtifactsPath)\native\x64\puttyengine.dll"
               Link="puttyengine.dll"
               CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
