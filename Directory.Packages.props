<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below force the version of a transitive dependency
         (needed to hold Microsoft.Windows.SDK.BuildTools.MSIX at a fixed build). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="WinUI app">
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- NativeAOT publish needs >= 1.7.260930100 (WindowsAppSDK issue 6394 fixed there).
         Windows App SDK 2.6.5 pulls 1.7.251221100 transitively, which predates the fix, so
         this entry relies on CentralPackageTransitivePinningEnabled above. -->
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.261102100" />
    <PackageVersion Include="Digi21.WinUI.Docking" Version="1.6.1-alpha.0.7" />
  </ItemGroup>

  <ItemGroup Label="MVVM and hosting">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
  </ItemGroup>

</Project>
