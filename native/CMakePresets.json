{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "x64",
      "displayName": "x64 (Ninja, MSVC)",
      "description": "Needs a Visual Studio developer environment; build\\native.cmd sets one up.",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "binaryDir": "${sourceDir}/../artifacts/native/x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "x64", "configurePreset": "x64" }
  ]
}
